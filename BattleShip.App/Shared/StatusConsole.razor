<div class="status-console radar-panel">
    <div class="status-console__item">
        <span class="hud-label">Statut</span>
        <strong>@StatusLabel(Game.Status)</strong>
    </div>
    <div class="status-console__item">
        <span class="hud-label">Tour</span>
        <strong>
            @(Game.CurrentTurn switch
            {
                PlayerSide.Player or PlayerSide.Player1 => "JOUEUR",
                PlayerSide.Computer => "ORDINATEUR",
                PlayerSide.Player2 => "ADVERSAIRE",
                _ => "—",
            })
        </strong>
    </div>
    <div class="status-console__item">
        <span class="hud-label">Grille</span>
        <strong>@Game.BoardSize x @Game.BoardSize</strong>
    </div>
    <div class="status-console__item">
        <span class="hud-label">Tirs joues</span>
        <strong>@Game.ShotCount</strong>
    </div>
    @if (Stats is not null)
    {
        <div class="status-console__item">
            <span class="hud-label">Tirs joueur (gRPC)</span>
            <strong>@Stats.PlayerShots</strong>
        </div>
        <div class="status-console__item">
            <span class="hud-label">Tirs adversaire (gRPC)</span>
            <strong>@Stats.ComputerShots</strong>
        </div>
        <div class="status-console__item">
            <span class="hud-label">Touches joueur</span>
            <strong>@Stats.PlayerHits</strong>
        </div>
        <div class="status-console__item">
            <span class="hud-label">Touches adversaire</span>
            <strong>@Stats.ComputerHits</strong>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required GameDto Game { get; set; }
    [Parameter] public GameStatsDto? Stats { get; set; }

    private static string StatusLabel(GameStatus status) => status switch
    {
        GameStatus.Waiting => "EN ATTENTE",
        GameStatus.PlayerTurn => "A VOUS DE JOUER",
        GameStatus.ComputerTurn => "L'ADVERSAIRE VISE",
        GameStatus.PlayerWon or GameStatus.Player1Won => "VICTOIRE",
        GameStatus.ComputerWon or GameStatus.Player2Won => "DEFAITE",
        GameStatus.Player1Turn => "TOUR JOUEUR 1",
        GameStatus.Player2Turn => "TOUR JOUEUR 2",
        _ => status.ToString(),
    };
}
